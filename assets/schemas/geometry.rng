<?xml version="1.0" encoding="UTF-8"?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
         xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"
         datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
    <start>
        <element name="geometry">
            <oneOrMore>
                <element name="group">
                    <attribute name="name"/>
                    <zeroOrMore>
                        <element name="sprite">
                            <attribute name="name"/>
                            <optional>
                                <attribute name="scale">
                                    <data type="float"/>
                                </attribute>
                            </optional>
                            <optional>
                                <attribute name="base">
                                    <text/>
                                </attribute>
                            </optional>
                            <optional>
                                <attribute name="slot">
                                    <text/>
                                </attribute>
                            </optional>
                            <optional>
                                <attribute name="default">
                                    <data type="boolean"/>
                                </attribute>
                            </optional>
                            <optional>
                                <attribute name="event">
                                    <text/>
                                </attribute>
                            </optional>
                            <optional>
                                <attribute name="skin">
                                    <text/>
                                </attribute>
                            </optional>
                            <optional>
                                <attribute name="replaces">
                                    <text/>
                                </attribute>
                            </optional>
                            <optional>
                                <attribute name="decoration">
                                    <text/>
                                </attribute>
                            </optional>
                            <optional>
                                <attribute name="count">
                                    <data type="positiveInteger"/>
                                </attribute>
                            </optional>
                            <optional>
                                <element name="skeleton">
                                    <attribute name="path"/>
                                </element>
                            </optional>
                            <oneOrMore>
                                <element name="model">
                                    <attribute name="path"/>
                                    <attribute name="r">
                                        <data type="integer"/>
                                    </attribute>
                                    <attribute name="g">
                                        <data type="integer"/>
                                    </attribute>
                                    <attribute name="b">
                                        <data type="integer"/>
                                    </attribute>
                                    <zeroOrMore>
                                        <element name="texture">
                                            <attribute name="name"/>
                                            <optional>
                                                <attribute name="team"/>
                                            </optional>
                                            <optional>
                                                <attribute name="normal"/>
                                            </optional>
                                            <optional>
                                                <attribute name="emissive">
                                                    <text/>
                                                </attribute>
                                            </optional>
                                            <optional>
                                                <attribute name="light_color">
                                                    <text/>
                                                </attribute>
                                            </optional>
                                            <optional>
                                                <attribute name="light_strength">
                                                    <data type="float"/>
                                                </attribute>
                                            </optional>
                                            <optional>
                                                <attribute name="light_reach">
                                                    <data type="float"/>
                                                </attribute>
                                            </optional>
                                        </element>
                                    </zeroOrMore>
                                </element>
                            </oneOrMore>
                            <zeroOrMore>
                                <element name="animation">
                                    <attribute name="name"/>
                                    <attribute name="wpc">
                                        <data type="float"/>
                                    </attribute>
                                    <attribute name="type">
                                        <choice>
                                            <value>loop</value>
                                            <value>plain</value>
                                        </choice>
                                    </attribute>
                                    <attribute name="path"/>
                                </element>
                            </zeroOrMore>
                        </element>
                    </zeroOrMore>
                </element>
            </oneOrMore>
        </element>
    </start>
</grammar>
